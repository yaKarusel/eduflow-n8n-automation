# Standalone defaults. Copy to .env and replace every CHANGE_ME value.
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROJECT_NAME=eduflow
DOMAIN=eduflow.example.com
N8N_PROTOCOL=https
N8N_HOST=eduflow.example.com
WEBHOOK_URL=https://eduflow.example.com/
GENERIC_TIMEZONE=Europe/Berlin
NODE_OPTIONS=--max-old-space-size=704

POSTGRES_DB=eduflow
POSTGRES_USER=eduflow
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
N8N_ENCRYPTION_KEY=CHANGE_ME_RANDOM_64_HEX

META_MODE=mock
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=CHANGE_ME_RANDOM_VERIFY_TOKEN
META_IG_ACCOUNT_ID=
META_API_VERSION=v26.0

MOCK_API_TOKEN=CHANGE_ME_RANDOM_MOCK_TOKEN
APPROVAL_SECRET=CHANGE_ME_RANDOM_APPROVAL_SECRET
HOT_LEAD_THRESHOLD=50
ANALYTICS_HOUR=9
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

EDUFLOW_N8N_INTERNAL_URL=http://n8n:5678
EDUFLOW_MOCK_URL=http://mock-api:8080
EDUFLOW_PUBLIC_URL=https://eduflow.example.com
ALLOWED_MEDIA_HOSTS=example.com,cdn.example.com
