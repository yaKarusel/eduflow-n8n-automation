      "typeVersion": 2.2,
      "position": [
        760,
        -180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://api.telegram.org/bot\" + $env.TELEGRAM_BOT_TOKEN + \"/sendMessage\" }}",
        "sendHeaders": false,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-token",
              "value": "={{ $env.META_MODE === \"mock\" ? $env.MOCK_API_TOKEN : \"\" }}"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.META_MODE === \"live\" ? \"Bearer \" + $env.META_ACCESS_TOKEN : \"\" }}"
            },
            {
              "name": "x-request-id",
              "value": "={{ $json.correlation_id || $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({chat_id:$env.TELEGRAM_CHAT_ID,text:\"🔥 Горячий лид EduFlow из Instagram DM\nEvent: \"+$json.event_id+\"\nScore: \"+$json.score}) }}"
      },
      "id": "telegram-hot-lead-1010-280",
      "name": "Telegram Hot Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1010,
        -280
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT eduflow_record_outbound($1,'FAILED',$2,$3,$4::jsonb);\nUPDATE workflow_events SET status='FAILED',processing_ms=(extract(epoch from (now()-created_at))*1000)::int WHERE external_event_id=$5;\nINSERT INTO error_logs(workflow_name,execution_id,node_name,severity,error_message,http_status,source,correlation_id,fingerprint,sanitized_details)\nVALUES('01 EduFlow - DM Lead Qualification',$6,'Send DM Reply','error',$7,$2,'instagram_dm',$8,'dm-send:'||$2,jsonb_build_object('event_id',$5,'http_status',$2));\nSELECT false AS ok,'OUTBOUND_FAILED' AS status,$5::text AS event_id;",
        "options": {
          "queryReplacement": "={{ [\"dm-reply:\"+$(\"Store DM Transaction\").item.json.event_id,Number($json.httpCode||$json.statusCode||500),$json.request_id||\"\",JSON.stringify($json),$(\"Store DM Transaction\").item.json.event_id,$execution.id,String($json.message||$json.error||\"Outbound request failed\"),$(\"Store DM Transaction\").item.json.correlation_id] }}"
        }
      },
