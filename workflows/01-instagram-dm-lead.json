        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Notify Manager-condition",
              "leftValue": "={{ Number($json.score) >= Number($env.HOT_LEAD_THRESHOLD || 50) && $env.TELEGRAM_ENABLED === \"true\" }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "notify-manager-760-180",
      "name": "Notify Manager",
