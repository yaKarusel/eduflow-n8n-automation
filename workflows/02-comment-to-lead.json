{
  "id": "EFCOMMENT0000001",
  "name": "02 EduFlow - Comment to Lead",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## 02 — Comment → Lead\n\nDetects campaign keywords without AI, ignores unrelated comments, creates a lead transactionally, and sends one private reply. Duplicate webhook deliveries are acknowledged without repeating side effects.",
        "width": 520,
        "height": 260
      },
      "id": "comment-architecture-820-380",
      "name": "Comment Architecture",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -820,
        -380
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "eduflow/instagram/comment",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "instagram-comment-webhook-760-0",
      "name": "Instagram Comment Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -760,
        0
      ],
      "webhookId": "webhook-eduflow-instagram-comment"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH input AS (\n  SELECT $1::text comment_id,$2::text media_id,$3::text user_id,$4::text username,left($5::text,4000) body,$6::text correlation_id,$7::jsonb payload\n), matched AS (\n  SELECT *,CASE WHEN lower(body) LIKE '%гайд%' THEN 'гайд' WHEN lower(body) LIKE '%пробн%' THEN 'пробный'\n    WHEN lower(body) LIKE '%урок%' THEN 'урок' WHEN lower(body) LIKE '%курс%' THEN 'курс'\n    WHEN lower(body) LIKE '%python%' THEN 'python' WHEN lower(body) LIKE '%обуч%' THEN 'обучение'\n    WHEN lower(body) LIKE '%чек-лист%' THEN 'чек-лист' ELSE '' END keyword FROM input\n), ready AS (\n  SELECT *,CASE WHEN lower(body) ~ '(хочу|купить|запис|цена|стоим)' THEN true ELSE false END hot,\n    CASE WHEN lower(body) LIKE '%python%' THEN 'python-organic' WHEN keyword<>'' THEN 'education-organic' ELSE 'unmatched' END campaign,\n    CASE WHEN keyword<>'' THEN 'Спасибо за интерес! Отправляем материалы EduFlow в личные сообщения. Если нужна консультация — ответьте «хочу консультацию».' ELSE '' END reply_text\n  FROM matched\n)\nSELECT result.*,ready.comment_id,ready.media_id,ready.user_id,ready.correlation_id\nFROM ready CROSS JOIN LATERAL eduflow_process_comment(ready.comment_id,ready.media_id,ready.user_id,ready.username,ready.body,ready.keyword,ready.campaign,ready.reply_text,ready.hot,ready.correlation_id,ready.payload) result;",
        "options": {
          "queryReplacement": "={{ [$json.body?.comment_id || $json.body?.entry?.[0]?.changes?.[0]?.value?.id || \"\",$json.body?.media_id || $json.body?.entry?.[0]?.changes?.[0]?.value?.media?.id || \"\",$json.body?.user_id || $json.body?.entry?.[0]?.changes?.[0]?.value?.from?.id || \"\",$json.body?.username || $json.body?.entry?.[0]?.changes?.[0]?.value?.from?.username || \"\",$json.body?.text || $json.body?.entry?.[0]?.changes?.[0]?.value?.text || \"\",$json.headers?.[\"x-request-id\"] || \"comment-\"+($json.body?.comment_id || $execution.id),JSON.stringify($json.body || {})] }}"
        }
      },
      "id": "store-comment-transaction-260-0",
      "name": "Store Comment Transaction",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -260,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "EFPOSTGRES000001",
          "name": "EduFlow PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "Actionable New Comment-condition",
              "leftValue": "={{ $json.processed && $json.actionable }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "actionable-new-comment-0-0",
      "name": "Actionable New Comment",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.META_MODE === \"mock\" ? $env.EDUFLOW_MOCK_URL + \"/v1/comments/private-reply\" : \"https://graph.facebook.com/\" + $env.META_API_VERSION + \"/\" + $json.comment_id + \"/private_replies\" }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-token",
              "value": "={{ $env.META_MODE === \"mock\" ? $env.MOCK_API_TOKEN : \"\" }}"
            },
            {
              "name": "Authorization",
              "value": "={{ $env.META_MODE === \"live\" ? \"Bearer \" + $env.META_ACCESS_TOKEN : \"\" }}"
            },
            {
              "name": "x-request-id",
              "value": "={{ $json.correlation_id || $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify($env.META_MODE === \"mock\" ? {comment_id:$json.comment_id,text:$json.reply_text,idempotency_key:\"comment-reply:\"+$json.comment_id} : {message:$json.reply_text}) }}"
      },
      "id": "send-private-reply-260-100",
      "name": "Send Private Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT eduflow_record_outbound($1,'SENT',200,$2,$3::jsonb);\nUPDATE comments SET processing_status='REPLIED',reply_sent_at=now() WHERE external_comment_id=$4;\nUPDATE workflow_events SET status='COMPLETED',processing_ms=(extract(epoch from (now()-created_at))*1000)::int WHERE external_event_id=$4;\nSELECT true AS ok,$4::text AS comment_id;",
        "options": {
          "queryReplacement": "={{ [\"comment-reply:\"+$(\"Store Comment Transaction\").item.json.comment_id,$json.request_id||\"\",JSON.stringify($json),$(\"Store Comment Transaction\").item.json.comment_id] }}"
        }
      },
      "id": "record-comment-success-530-180",
      "name": "Record Comment Success",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        530,
        -180
      ],
      "credentials": {
        "postgres": {
          "id": "EFPOSTGRES000001",
          "name": "EduFlow PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT eduflow_record_outbound($1,'FAILED',$2,$3,$4::jsonb);\nUPDATE comments SET processing_status='FAILED' WHERE external_comment_id=$5;\nUPDATE workflow_events SET status='FAILED' WHERE external_event_id=$5;\nINSERT INTO error_logs(workflow_name,execution_id,node_name,severity,error_message,http_status,source,correlation_id,fingerprint,sanitized_details)\nVALUES('02 EduFlow - Comment to Lead',$6,'Send Private Reply','error',$7,$2,'instagram_comment',$8,'comment-send:'||$2,jsonb_build_object('comment_id',$5));\nSELECT false AS ok,'OUTBOUND_FAILED' AS status,$5::text AS comment_id;",
        "options": {
          "queryReplacement": "={{ [\"comment-reply:\"+$(\"Store Comment Transaction\").item.json.comment_id,Number($json.httpCode||$json.statusCode||500),$json.request_id||\"\",JSON.stringify($json),$(\"Store Comment Transaction\").item.json.comment_id,$execution.id,String($json.message||$json.error||\"Outbound request failed\"),$(\"Store Comment Transaction\").item.json.correlation_id] }}"
        }
      },
      "id": "record-comment-failure-530-70",
