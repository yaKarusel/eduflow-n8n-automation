{
  "id": "EFCONTENT0000001",
  "name": "03 EduFlow - Content Approval Publishing",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## 03 — Content approval and publishing\n\nSeparate authenticated endpoints create drafts and record approve/reject decisions. Approved due items are published immediately or by a five-minute scheduler. Media hosts are allow-listed. Mock mode is deterministic; live mode uses the current Graph API container + publish sequence and must be validated with the client Meta app.",
        "width": 520,
        "height": 260
      },
      "id": "content-architecture-980-500",
      "name": "Content Architecture",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -980,
        -500
      ]
    },
    {
      "parameters": {
