        "operation": "executeQuery",
        "query": "SELECT eduflow_record_publication($1,$2,$3,$4::jsonb); SELECT true AS ok,$1::text AS public_id,$2::text AS publication_id;",
        "options": {
          "queryReplacement": "={{ [$(\"Record Decision\").isExecuted ? $(\"Record Decision\").item.json.public_id : $(\"Select Due Content\").item.json.public_id,$json.publication_id || $json.id || \"\",$json.request_id || \"\",JSON.stringify($json)] }}"
